# Paste your deployed C# game server URL here.
# After deploying the server folder to Railway or Render,
# copy its public URL and set it below.
#
# Example:
#   NEXT_PUBLIC_GAME_SERVER_URL=wss://arena-game-server.up.railway.app/ws
#
# This makes the server address pre-filled in the game UI automatically.
NEXT_PUBLIC_GAME_SERVER_URL=wss://YOUR_SERVER_URL_HERE/ws
